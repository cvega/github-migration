{
  "name": "gh-migrate-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "auth:reset": "bun scripts/auth/reset-admin-password.ts",
    "build": "bun scripts/packaging/build.ts",
    "check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev": "bunx --bun vite dev",
    "docs:check": "bun scripts/docs/semantic-docs.ts --check && bun scripts/docs/docs-check.ts",
    "docs:sync": "bun scripts/docs/semantic-docs.ts --write",
    "format": "bunx --bun biome format --write .",
    "lint": "bunx --bun biome check --error-on-warnings .",
    "mutation": "bun scripts/checks/mutation-runner.ts",
    "preview": "bunx --bun vite preview",
    "release:prep": "bun scripts/release/release-prep.ts",
    "seed": "bun scripts/fixtures/seed.ts",
    "test": "bun test",
    "test:changed": "bun test --changed",
    "test:e2e": "bunx --bun playwright test",
    "typecheck": "bunx --bun svelte-kit sync && bunx --bun tsc --noEmit && bunx --bun tsc --noEmit -p scripts/tsconfig.json",
    "verify": "bun scripts/gates.ts --verbose --fail-fast"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/graphql": "^9.0.4",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@primer/primitives": "^11.10.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "jdenticon": "^3.3.0",
    "simple-icons": "^16.29.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@primer/octicons": "^19.33.0",
    "@stryker-mutator/core": "^10.0.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/primer__octicons": "^19.21.0",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "git-cliff": "^2.13.1",
    "jscpd": "^5.0.16",
    "knip": "^6.33.0",
    "madge": "^8.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "qs": "^6.15.2"
  }
}
