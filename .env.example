# Dashboard access: choose authenticated login or explicit trusted-network mode.
# These credentials create the first administrator only when the user table is empty.
# GH_MIGRATE_USER=admin
# GH_MIGRATE_PASS=replace-with-at-least-12-characters
GH_MIGRATE_ALLOW_UNAUTHENTICATED=true

# Optional Prometheus endpoint: set a separate, random token with no whitespace.
# GH_MIGRATE_METRICS_TOKEN=

# Docker publication and public URL.
# GH_MIGRATE_PUBLISH_HOST=127.0.0.1
# GH_MIGRATE_IMAGE=gh-migrate:local
# GH_MIGRATE_ANALYZER_IMAGE=gh-migrate-profile-analyzer:local
# Must match the browser URL, including scheme and port. Change for LAN or HTTPS access.
ORIGIN=http://localhost:3000
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Storage. Compose overrides these with its named volumes.
# DATA_DIR=./data
# ARCHIVE_DIR=/absolute/path/to/archives
# PORT=3000

# GitHub source and target defaults. Configure a PAT or all three App values per side.
# GH_SOURCE_API_URL=https://api.github.com
# GH_SOURCE_ORG=source-org
# GH_SOURCE_PAT=ghp_replace-me
# GH_SOURCE_APP_ID=12345
# GH_SOURCE_APP_PRIVATE_KEY=base64-encoded-pem
# GH_SOURCE_APP_INSTALLATION_ID=67890
# GH_TARGET_ORG=target-org
# GH_TARGET_PAT=ghp_replace-me
# GH_TARGET_APP_ID=12345
# GH_TARGET_APP_PRIVATE_KEY=base64-encoded-pem
# GH_TARGET_APP_INSTALLATION_ID=67890
# GH_ALLOWED_SOURCE_API_URLS=https://ghes.example.com/api/v3
# Optional exact source API URLs allowed to bypass certificate verification (empty by default).
# GH_ALLOW_INSECURE_SOURCE_TLS=
# GH_ALLOW_CREDENTIAL_OVERRIDE=false

# GitLab source.
# GITLAB_SOURCE_API_URL=https://gitlab.example.com
# GITLAB_SOURCE_PAT=glpat-replace-me
# GITLAB_SOURCE_USERNAME=migration-admin
# GITLAB_SOURCE_NAMESPACE=platform,products/payments
# GITLAB_SOURCE_MAX_ARCHIVE_BYTES=42949672960
# GITLAB_SOURCE_ARCHIVE_DOWNLOAD_TIMEOUT_MS=1800000

# Bitbucket Server/Data Center source.
# BITBUCKET_SERVER_URL=https://bitbucket.example.com
# BITBUCKET_SERVER_USERNAME=migration-user
# BITBUCKET_SERVER_PASSWORD=replace-me
# BITBUCKET_SERVER_PROJECT_KEYS=PLATFORM,TOOLS
# Optional: allow dashboard operators to profile the full readable scope of these
# connections instead of the migration namespace list. Does not grant migration access.
# PROFILE_CONNECTION_SCOPE=bitbucket-server,gitlab,github
# BITBUCKET_SERVER_ALLOW_INSECURE_HTTP=false
# Source SSH and shared home below are for Bitbucket-to-GHEC, not Bitbucket-to-GHES.
# BITBUCKET_SERVER_SSH_HOST=bitbucket.example.com
# BITBUCKET_SERVER_SSH_PORT=22
# BITBUCKET_SERVER_SSH_USERNAME=bitbucket
# BITBUCKET_SERVER_SSH_PRIVATE_KEY=base64-encoded-private-key
# BITBUCKET_SERVER_SSH_HOST_KEY_SHA256=base64-sha256-fingerprint
# BITBUCKET_SERVER_SHARED_HOME=/var/atlassian/application-data/bitbucket/shared
# BITBUCKET_SERVER_MAX_ARCHIVE_BYTES=42949672960

# Optional administrator-owned GHES target profile. First install: docs/bitbucket-datacenter-to-ghes.md
# GHES_TARGET_ID=production
# GHES_TARGET_NAME=GitHub Enterprise Server
# GHES_TARGET_API_URL=https://ghes.example.com
# GHES_TARGET_ORG=engineering,platform
# GHES_TARGET_ADMIN_USERNAME=site-admin
# GHES_TARGET_ADMIN_PAT=replace-with-site-admin-pat-issued-on-this-ghes-instance
# GHES_TARGET_SSH_HOST=ghes.example.com
# GHES_TARGET_SSH_PORT=122
# GHES_TARGET_SSH_USERNAME=admin
# GHES_TARGET_SSH_PRIVATE_KEY=base64-encoded-private-key
# GHES_TARGET_SSH_HOST_KEY_SHA256=SHA256:verified-appliance-host-fingerprint
# GHES_TARGET_REMOTE_DIR=/home/admin

# Exporter images, volume, runtime, and sandbox limits.
# Build either private release from a directory or .tar.gz (no migration credentials):
# python3 scripts/packaging/build-exporter.py <bitbucket|gitlab> /path/to/release
# Example: COMPOSE_FILE=docker-compose.yml:deploy/bitbucket/compose.bitbucket-exporter.yml
# GL_EXPORTER_IMAGE=gh-migrate/gitlab-exporter:1.7.17
# BBS_EXPORTER_IMAGE=gh-migrate/bitbucket-exporter:1.13.0
# Optional direct Compose build contexts are directories only; use the helper for a tar.gz.
# GL_EXPORTER_BUILD_CONTEXT=../gl-exporter-1.7.17
# BBS_EXPORTER_BUILD_CONTEXT=../bbs-exporter-1.13.0
# Compose supplies EXPORTER_ARCHIVE_VOLUME and the exporter images. For bun run dev
# with Bitbucket-to-GHES, set ARCHIVE_DIR, EXPORTER_ARCHIVE_VOLUME and BBS_EXPORTER_IMAGE
# here; the volume must be backed by ARCHIVE_DIR. See docs/configuration.md.
# EXPORTER_ARCHIVE_VOLUME=gh-migrate-archives
# GHES exporter wait deadline in milliseconds, measured from job creation (default 6 hours).
# GHES_EXPORT_TIMEOUT_MS=21600000
# EXPORTER_RUNTIME=docker
# Use the source's Docker network for a local source stack, e.g. bitbucket-local_default.
# EXPORTER_NETWORK=bridge
# EXPORTER_MEMORY=2g
# EXPORTER_CPUS=2
# EXPORTER_PIDS_LIMIT=256
# EXPORTER_TMPFS_SIZE=1g

# Retention policy.
# MIGRATION_RETENTION_DAYS=90
# MIGRATION_RETENTION_ROWS=100000
# PROFILE_RETENTION_DAYS=90
# PROFILE_RETENTION_RUNS=500
